{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "distDir": "../dist",
    "devPath": "http://localhost:5180"
  },
  "package": {
    "productName": "Nemocode",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.nemocode.app"
    },
    "windows": [
      {
        "title": "Nemocode Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
